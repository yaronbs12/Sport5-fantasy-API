# ==============================================================================
# Sport5 Fantasy API - Environment Configuration Example
# Copy this file to '.env' and adjust values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# Server & Application Settings
# ------------------------------------------------------------------------------
# FastAPI application title shown in OpenAPI documentation
FANTASY_APP_TITLE="Sport5 Fantasy API"

# Semantic version of the service
FANTASY_APP_VERSION="0.1.0"

# Debug mode: Set to false in production. Never enable True in public deployments.
FANTASY_DEBUG=false

# Allowed CORS origins (comma-separated). Use "*" for local development,
# or specify explicit domains (e.g., "https://myfrontend.com,http://localhost:3000")
FANTASY_CORS_ORIGINS="*"

# ------------------------------------------------------------------------------
# Tournament Upstream Base URLs & Default Season IDs
# ------------------------------------------------------------------------------
# Israeli Premier League (Football - Ligat Ha'Al / Dream Team)
FANTASY_ISRAELI_LEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_ISRAELI_LEAGUE_DEFAULT_SEASON_ID=10

# UEFA Champions League Fantasy (Football)
FANTASY_CHAMPIONS_LEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_CHAMPIONS_LEAGUE_DEFAULT_SEASON_ID=12

# Euroleague Fantasy (Basketball)
FANTASY_EUROLEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_EUROLEAGUE_DEFAULT_SEASON_ID=11

# FIFA World Cup Fantasy (Football)
FANTASY_WORLD_CUP_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_WORLD_CUP_DEFAULT_SEASON_ID=9

# UEFA Euro Archive Fantasy (Football - Inactive)
FANTASY_EURO_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_EURO_DEFAULT_SEASON_ID=3

# ------------------------------------------------------------------------------
# In-Memory TTL Cache Configuration (Values in seconds)
# ------------------------------------------------------------------------------
# Season & tournament discovery cache duration (default: 86400s = 24 hours)
FANTASY_CACHE_TTL_SEASON_DISCOVERY=86400

# Club teams directory cache duration (default: 3600s = 1 hour)
FANTASY_CACHE_TTL_TEAMS=3600

# Player pool cache duration (default: 600s = 10 minutes)
FANTASY_CACHE_TTL_PLAYERS=600

# Gameweek fixtures and rounds cache duration (default: 900s = 15 minutes)
FANTASY_CACHE_TTL_FIXTURES=900

# ------------------------------------------------------------------------------
# Upstream HTTP Client & Networking Resilience
# ------------------------------------------------------------------------------
# Total request timeout in seconds for outbound HTTP calls
FANTASY_HTTP_TIMEOUT_SECONDS=15.0

# Maximum number of automatic retries on transient network errors (502, 503, 504, timeouts)
FANTASY_HTTP_MAX_RETRIES=2
