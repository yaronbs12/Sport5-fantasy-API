# ===========================================================================
# Sport5 Fantasy API & SDK - Environment Configuration Example
# ===========================================================================
# Copy this file to .env and adjust values for your environment.
# All environment variables can be prefixed with FANTASY_ (recommended).
# ===========================================================================

# ---------------------------------------------------------------------------
# Server Settings
# ---------------------------------------------------------------------------
FANTASY_APP_TITLE="Sport5 Fantasy API"
FANTASY_APP_VERSION="0.1.0"
FANTASY_DEBUG=false

# ---------------------------------------------------------------------------
# CORS Configuration
# ---------------------------------------------------------------------------
# Comma-separated list of allowed origins.
# For production, set to your specific web client origins, e.g.:
# FANTASY_CORS_ORIGINS="https://myfantasyapp.com,http://localhost:3000"
FANTASY_CORS_ORIGINS="*"

# ---------------------------------------------------------------------------
# Upstream Sport5 Base URLs & Fallback Season IDs
# ---------------------------------------------------------------------------
FANTASY_ISRAELI_LEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_ISRAELI_LEAGUE_DEFAULT_SEASON_ID=10

FANTASY_CHAMPIONS_LEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_CHAMPIONS_LEAGUE_DEFAULT_SEASON_ID=12

FANTASY_EUROLEAGUE_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_EUROLEAGUE_DEFAULT_SEASON_ID=11

FANTASY_WORLD_CUP_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_WORLD_CUP_DEFAULT_SEASON_ID=9

FANTASY_EURO_BASE_URL="https://dreamteam.sport5.co.il"
FANTASY_EURO_DEFAULT_SEASON_ID=3

# ---------------------------------------------------------------------------
# Cache TTLs (Seconds)
# ---------------------------------------------------------------------------
FANTASY_CACHE_TTL_SEASON_DISCOVERY=86400  # 24 hours
FANTASY_CACHE_TTL_TEAMS=3600             # 1 hour
FANTASY_CACHE_TTL_PLAYERS=600            # 10 minutes
FANTASY_CACHE_TTL_FIXTURES=900           # 15 minutes

# ---------------------------------------------------------------------------
# HTTP Client & Upstream Request Settings
# ---------------------------------------------------------------------------
FANTASY_HTTP_TIMEOUT_SECONDS=15.0
FANTASY_HTTP_MAX_RETRIES=2
